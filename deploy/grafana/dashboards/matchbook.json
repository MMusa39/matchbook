          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(matchbook_engine_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
